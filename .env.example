# ─── Supabase (public — safe for the browser) ─────────────────────────────────
# Create a project at https://supabase.com and copy these from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase (server-only) ───────────────────────────────────────────────────
# Project Settings → API → service_role. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI bill scanning (server-only — Phase 7) ─────────────────────────────────
# Default provider is Google Gemini. OpenAI / Anthropic are supported swaps.
VISION_PROVIDER=google
VISION_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000